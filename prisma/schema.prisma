// CertiPort Certificate & Card Platform — Prisma schema
// Matches SRS v2.1 entities: multi-tenant, 5-actor RBAC, Module 1 (Certificates)
// and Module 2 (Cards) with full approval workflow + governance.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
// Tenancy & Identity
// ---------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  templates     Template[]
  certificates  Certificate[]
  cardRequests  CardRequest[]
  auditLogs     AuditLog[]
  notifEvents   NotificationSetting[]
}

enum Role {
  SUPER_ADMIN   // platform-wide, cross-tenant
  ORG_ADMIN     // org-scoped admin
  CERT_ISSUER   // certificate issuance only
  HR            // card creation only
}

enum UserStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

model User {
  id             String     @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  name           String
  email          String     @unique
  passwordHash   String?    // null if the user only ever signs in via SSO
  role           Role
  status         UserStatus @default(INVITED)
  mfaEnabled     Boolean    @default(false)
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  temporaryGrantsReceived TemporaryAccess[] @relation("GrantRecipient")
  temporaryGrantsIssued   TemporaryAccess[] @relation("GrantIssuer")
  auditLogs               AuditLog[]
  certificatesIssued      Certificate[]     @relation("IssuedBy")
  cardRequestsSubmitted   CardRequest[]     @relation("SubmittedBy")
  accounts                Account[]
  sessions                Session[]

  @@index([organizationId])
}

// NextAuth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------
// Access Transformation (SRS §3.5) — temporary permission grants
// ---------------------------------------------------------------

enum GrantStatus {
  SCHEDULED
  ACTIVE
  EXPIRED
  REVOKED
}

model TemporaryAccess {
  id           String      @id @default(cuid())
  recipientId  String
  recipient    User        @relation("GrantRecipient", fields: [recipientId], references: [id])
  grantedById  String
  grantedBy    User        @relation("GrantIssuer", fields: [grantedById], references: [id])
  permission   String      // e.g. "bulk-upload", "approve-card", "manage-templates"
  reason       String
  startsAt     DateTime
  expiresAt    DateTime
  status       GrantStatus @default(SCHEDULED)
  createdAt    DateTime    @default(now())

  @@index([recipientId])
}

// ---------------------------------------------------------------
// Module 1 — Certificate Automation
// ---------------------------------------------------------------

enum TemplateType {
  CERTIFICATE
  ID_CARD
  BUSINESS_CARD
}

enum TemplateSource {
  UPLOADED_IMAGE
  UPLOADED_HTML
  UPLOADED_PDF
  DESIGNED_FROM_SCRATCH
}

model Template {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  name           String
  type           TemplateType
  source         TemplateSource
  version        Int            @default(1)
  isActive       Boolean        @default(true)
  isDefault      Boolean        @default(false)
  backgroundUrl  String?        // object storage URL for image-based templates
  backgroundHtml String?        @db.Text // for HTML-imported templates
  fieldLayout    Json           // array of {fieldId, left, top, width, height, fontSize, ...}
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  certificates   Certificate[]
  cardRequests   CardRequest[]

  @@index([organizationId, type])
}

enum CertificateStatus {
  DRAFT
  GENERATING
  GENERATED
  ISSUED
  DELIVERED
  REVOKED
}

model Certificate {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  templateId     String
  template       Template          @relation(fields: [templateId], references: [id])
  certificateRef String            @unique // e.g. MER/2026/UXFN/000214
  recipientName  String
  recipientEmail String
  recipientPhone String?
  courseName     String
  studentId      String?
  grade          String?
  status         CertificateStatus @default(DRAFT)
  qrPublicId     String            @unique @default(cuid()) // backs /verify/{publicId}
  fileUrl        String?           // generated PDF/PNG location once issued
  issuedById     String?
  issuedBy       User?             @relation("IssuedBy", fields: [issuedById], references: [id])
  issuedAt       DateTime?
  deliveredAt    DateTime?
  deliveryError  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId, status])
}

// ---------------------------------------------------------------
// Module 2 — ID / Business Card Generation (9-phase workflow)
// ---------------------------------------------------------------

enum CardType {
  ID_CARD
  BUSINESS_CARD
}

enum CardRequestStatus {
  DRAFT
  PENDING_APPROVAL
  CHANGES_REQUESTED
  APPROVED
  PENDING_CANDIDATE
  CANDIDATE_CHANGES
  CANDIDATE_APPROVED
  FINALIZED
  DELIVERED
}

model CardRequest {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  templateId     String
  template       Template           @relation(fields: [templateId], references: [id])
  type           CardType
  status         CardRequestStatus  @default(DRAFT)
  fields         Json               // {fullName, jobTitle, employeeId, bloodGroup, email, phone, photoUrl, ...}
  submittedById  String
  submittedBy    User               @relation("SubmittedBy", fields: [submittedById], references: [id])
  candidateToken String             @unique @default(cuid()) // powers the no-login review link
  tokenExpiresAt DateTime?
  fileUrl        String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  comments       CardRequestComment[]

  @@index([organizationId, status])
}

model CardRequestComment {
  id            String      @id @default(cuid())
  cardRequestId String
  cardRequest   CardRequest @relation(fields: [cardRequestId], references: [id], onDelete: Cascade)
  authorLabel   String      // e.g. "J. Fernandes (Admin)" or "Devon Marsh (Candidate)"
  body          String      @db.Text
  createdAt     DateTime    @default(now())
}

// ---------------------------------------------------------------
// Governance
// ---------------------------------------------------------------

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorId        String?
  actor          User?        @relation(fields: [actorId], references: [id])
  action         String       // e.g. "certificate.revoke", "permission.grant.temporary"
  entityType     String
  entityId       String
  oldValue       Json?
  newValue       Json?
  ipAddress      String?
  userAgent      String?
  requestId      String?
  createdAt      DateTime     @default(now())

  // Immutable by design: no update/delete is ever called against this model
  // from application code. Enforce with a DB-level REVOKE UPDATE/DELETE in
  // production (see README).

  @@index([organizationId, createdAt])
}

model NotificationSetting {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  eventKey       String       // e.g. "card-pending", "candidate-approved"
  emailEnabled   Boolean      @default(true)
  whatsappEnabled Boolean     @default(false)

  @@unique([organizationId, eventKey])
}
